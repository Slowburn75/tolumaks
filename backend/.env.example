DATABASE_URL="postgresql://user:password@host:5432/tolumak?sslmode=require"
NODE_ENV=development
PORT=4000

# Required strong secrets in production (app will refuse to start without them)
JWT_SECRET="replace-with-long-random-string"
JWT_REFRESH_SECRET="replace-with-different-long-random-string"
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Primary storefront URL (used for emails + CORS)
FRONTEND_URL=http://localhost:3000
# Comma-separated extra CORS origins (no trailing slashes)
# Example production:
# FRONTEND_URL=https://tolumaks.vercel.app
# FRONTEND_URLS=https://tolumak.com,https://www.tolumak.com
FRONTEND_URLS=
# Set true to allow any *.vercel.app preview deployment
ALLOW_VERCEL_PREVIEWS=false
BACKEND_URL=http://localhost:4000

# Payments (card flows disabled for now; webhooks still require secrets when enabled)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
CONTACT_EMAIL=hello@tolumak.com
